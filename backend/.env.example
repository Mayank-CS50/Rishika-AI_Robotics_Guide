# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# For OpenAI: get from https://platform.openai.com/api-keys (if using OpenAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Day 6 — Outbound calling. Pick ONE of the two options below.
#
# LiveKit sends the INVITE to  sip:<--to value>@<SIP_TRUNK_ADDRESS>
# so SIP_TRUNK_ADDRESS alone decides whether you reach a phone network or an app.
# -----------------------------------------------------------------------------

# --- Option A: free SIP softphone (no carrier, no card, your phone still rings) -
# 1. Create a free account at https://subscribe.linphone.org (or https://sip2sip.info)
# 2. Install the Linphone app on your phone and log in — leave it running
# 3. Run: uv run python src/setup_sip_trunk.py
# 4. Dial it: uv run python src/dispatch_outbound.py --to <your_sip_username>
SIP_TRUNK_ADDRESS=sip.linphone.org
# Most public registrars accept an unauthenticated INVITE; fill these only if yours refuses.
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=

# --- Option B: real PSTN via Twilio Elastic SIP Trunk (needs a paid number) ----
# Set SIP_TRUNK_ADDRESS above to your-trunk.pstn.twilio.com and fill these instead.
# TWILIO_SIP_TERM_URI=your-trunk.pstn.twilio.com
# TWILIO_SIP_USERNAME=your_sip_credential_username
# TWILIO_SIP_PASSWORD=your_sip_credential_password
# TWILIO_PHONE_NUMBER=+15551234567

# Printed by setup_sip_trunk.py — paste it back here.
SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Day 7 — human handoff. Both are optional.
#
# ESCALATION_WEBHOOK_URL: a Discord or Slack incoming webhook. Leave it empty and
# requests still land in SQLite — view them with `uv run python src/escalations.py`.
#   Discord: channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL
# -----------------------------------------------------------------------------
ESCALATION_WEBHOOK_URL=
# Port for the local mentor desk page (default 8787, binds to 127.0.0.1 only).
# ESCALATION_DESK_PORT=8787
